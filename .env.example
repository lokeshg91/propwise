# Propwise environment variables
# Copy this file to `.env.local` and adjust values as needed.
# Only variables prefixed with VITE_ are exposed to client code.

# Display name used in the UI and document title.
VITE_APP_NAME=Propwise

# Placeholder for a future API integration. The template ships with local
# mock data only; no requests are made to this URL yet.
VITE_API_BASE_URL=http://localhost:3000/api
